# Copy to .env (git-ignored). All variables are optional.
# Keys can instead be entered in Settings -> LLM Providers, where they are stored encrypted on the server.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama server (default http://localhost:11434; in Docker use http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Optional Fernet key for the credential store; otherwise var/secret.key is generated (chmod 600)
AGENTHILL_SECRET_KEY=
# Optional: PostgreSQL instead of SQLite, e.g. postgresql+psycopg://user:pass@host/agenthill
AGENTHILL_DATABASE_URL=
